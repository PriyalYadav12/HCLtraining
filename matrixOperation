import java.util.Scanner;

public class MatrixOperations {

    static Scanner sc = new Scanner(System.in);

    // Input matrix
    static int[][] inputMatrix(int r, int c) {
        int[][] m = new int[r][c];
        System.out.println("Enter matrix elements:");
        for (int i = 0; i < r; i++) {
            for (int j = 0; j < c; j++) {
                m[i][j] = sc.nextInt();
            }
        }
        return m;
    }

    // Print matrix
    static void printMatrix(int[][] m) {
        for (int[] row : m) {
            for (int val : row) {
                System.out.print(val + " ");
            }
            System.out.println();
        }
    }

    // Addition
    static int[][] add(int[][] a, int[][] b, int r, int c) {
        int[][] res = new int[r][c];
        for (int i = 0; i < r; i++)
            for (int j = 0; j < c; j++)
                res[i][j] = a[i][j] + b[i][j];
        return res;
    }

    // Subtraction
    static int[][] subtract(int[][] a, int[][] b, int r, int c) {
        int[][] res = new int[r][c];
        for (int i = 0; i < r; i++)
            for (int j = 0; j < c; j++)
                res[i][j] = a[i][j] - b[i][j];
        return res;
    }

    // Multiplication
    static int[][] multiply(int[][] a, int[][] b, int r1, int c1, int c2) {
        int[][] res = new int[r1][c2];
        for (int i = 0; i < r1; i++) {
            for (int j = 0; j < c2; j++) {
                for (int k = 0; k < c1; k++) {
                    res[i][j] += a[i][k] * b[k][j];
                }
            }
        }
        return res;
    }

    // Transpose
    static int[][] transpose(int[][] a, int r, int c) {
        int[][] t = new int[c][r];
        for (int i = 0; i < r; i++)
            for (int j = 0; j < c; j++)
                t[j][i] = a[i][j];
        return t;
    }

    // Check square matrix
    static boolean isSquare(int r, int c) {
        return r == c;
    }

    // Check diagonal matrix
    static boolean isDiagonal(int[][] m, int n) {
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                if (i != j && m[i][j] != 0)
                    return false;
        return true;
    }

    // Check identity matrix
    static boolean isIdentity(int[][] m, int n) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i == j && m[i][j] != 1)
                    return false;
                if (i != j && m[i][j] != 0)
                    return false;
            }
        }
        return true;
    }

    public static void main(String[] args) {

        System.out.print("Enter rows and columns: ");
        int r = sc.nextInt();
        int c = sc.nextInt();

        int[][] A = inputMatrix(r, c);

        System.out.println("\nMatrix A:");
        printMatrix(A);

        // Transpose
        System.out.println("\nTranspose:");
        printMatrix(transpose(A, r, c));

        // Square check
        if (isSquare(r, c)) {
            System.out.println("\nMatrix is Square");

            if (isDiagonal(A, r))
                System.out.println("Matrix is Diagonal");
            else
                System.out.println("Matrix is NOT Diagonal");

            if (isIdentity(A, r))
                System.out.println("Matrix is Identity");
            else
                System.out.println("Matrix is NOT Identity");

        } else {
            System.out.println("\nMatrix is NOT Square");
        }
    }
}
